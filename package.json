{
  "name": "maid-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:emulator": "firebase emulators:exec --project demo-maid-mgmt --only firestore,auth \"vitest run tests/emulator\"",
    "test:all": "npm run test:unit && npm run test:emulator",
    "bootstrap:manager": "tsx scripts/bootstrap-manager.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
