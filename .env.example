# Firebase Web (public) configuration
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only, used by API routes, scripts, and the
# automatic first-manager bootstrap in src/instrumentation.ts)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY (no ADMIN_
# prefix) are also accepted as a fallback if the ADMIN-prefixed ones aren't set.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n sequences when pasting the private key into Vercel/`.env.local`
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to "true" only when running against the Firebase Local Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# No variable is needed for the first-manager bootstrap: it runs automatically
# on server startup (src/instrumentation.ts) only while no active manager
# exists in Firestore yet, enforced by a permanent one-time lock
# (settings/setupState) claimed inside a Firestore transaction. See the
# README's "First manager bootstrap" section.
