# Firebase Web (public) configuration
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only, used by API routes and scripts)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n sequences when pasting the private key into Vercel/`.env.local`
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to "true" only when running against the Firebase Local Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# No variable is needed for /setup-first-manager: it works only while no
# active manager exists in Firestore yet, enforced by a permanent one-time
# lock (settings/setupState) claimed inside a Firestore transaction. See the
# README's "First manager bootstrap" section.
