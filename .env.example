# There is no Firebase Authentication in this app — no NEXT_PUBLIC_FIREBASE_*
# client config, and no client-side Firebase SDK at all. The browser never
# talks to Firestore directly; every read and write goes through Next.js API
# routes using the Firebase Admin SDK (Firestore only, not Auth).

# Firebase Admin (server-only, used by every API route for Firestore access)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY (no ADMIN_
# prefix) are also accepted as a fallback if the ADMIN-prefixed ones aren't set.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n sequences when pasting the private key into Vercel/`.env.local`
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to run against the Firebase Local Emulator Suite instead of production:
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# The manager password and the session-signing secret are intentionally NOT
# environment variables — see src/lib/server/managerAuth.ts.
