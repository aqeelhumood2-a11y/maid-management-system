# Firebase Web (public) configuration
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only, used by API routes and scripts)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n sequences when pasting the private key into Vercel/`.env.local`
FIREBASE_ADMIN_PRIVATE_KEY=

# Set to "true" only when running against the Firebase Local Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# One-time secret gating the /setup-first-manager web bootstrap page (server-only).
# Generate a long random value, e.g.: openssl rand -base64 32
# Required to be at least 20 characters; the endpoint refuses to run without it.
# It only ever needs to work once — the flow locks itself permanently in Firestore
# after the first manager account is created, so it's safe to leave this set
# afterward (or remove it once you no longer need the page).
FIRST_MANAGER_SETUP_SECRET=
