rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Every permission check re-reads the caller's own user doc, so a
    // deactivation or role change takes effect on the very next request
    // instead of waiting for the client's ID token to refresh.
    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        me().active == true;
    }

    function isManager() {
      return isActiveUser() && me().role == 'manager';
    }

    function isServerTimestamp(value) {
      return value == request.time;
    }

    // ---------------------------------------------------------------
    // users
    // Account creation, role assignment and activation are exclusively
    // performed by the Admin SDK (server API routes), which bypasses
    // rules entirely. Clients can never write here, so a signed-in user
    // can never promote themselves or reactivate their own account.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isManager());
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // areas
    // ---------------------------------------------------------------
    match /areas/{areaId} {
      allow read: if isActiveUser();
      allow create: if isManager() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.active == true &&
        request.resource.data.createdBy == request.auth.uid &&
        isServerTimestamp(request.resource.data.createdAt) &&
        isServerTimestamp(request.resource.data.updatedAt);
      allow update: if isManager() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.active is bool &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        isServerTimestamp(request.resource.data.updatedAt) &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // workers
    // ---------------------------------------------------------------
    match /workers/{workerId} {
      allow read: if isActiveUser();
      allow create: if isManager() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.active == true &&
        request.resource.data.createdBy == request.auth.uid &&
        isServerTimestamp(request.resource.data.createdAt) &&
        isServerTimestamp(request.resource.data.updatedAt);
      allow update: if isManager() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.active is bool &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        isServerTimestamp(request.resource.data.updatedAt) &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // slots — the double-booking lock. A slot document id is always
    // `${workerId}_${date}_${shift}`.
    //
    // Writes are exclusively performed server-side, through the Admin SDK
    // (see src/lib/server/bookingService.ts, called only from the API
    // routes under src/app/api/bookings and src/app/api/recurring). That
    // server layer is what enforces "only a manager may create, edit, or
    // move a booking into a Friday slot" — a rule Firestore Security Rules
    // cannot reliably evaluate, since it would need to derive a weekday
    // from a plain `yyyy-MM-dd` string. Denying all direct client writes
    // here removes the bypass entirely rather than trying to re-implement
    // that check in the rules language. Reads stay open for the real-time
    // schedule grids and reports.
    // ---------------------------------------------------------------
    match /slots/{slotId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // bookings — see the note on /slots above; same rationale applies.
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // recurringSchedules & recurringExceptions — manager-only feature.
    // The "single" edit/cancel scopes materialize or release a concrete
    // Booking, so these are written server-side too (see
    // src/lib/server/recurringService.ts) for the same reason as /bookings.
    // ---------------------------------------------------------------
    match /recurringSchedules/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /recurringExceptions/{id} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // activityLogs — append-only audit trail, manager-readable only.
    // ---------------------------------------------------------------
    match /activityLogs/{id} {
      allow read: if isManager();
      allow create: if isActiveUser() &&
        request.resource.data.actingUid == request.auth.uid &&
        isServerTimestamp(request.resource.data.createdAt);
      allow update: if false;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // settings
    // ---------------------------------------------------------------
    match /settings/{id} {
      allow read: if isActiveUser();
      allow write: if isManager() &&
        request.resource.data.timezone == 'Asia/Bahrain' &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() > 0 &&
        isServerTimestamp(request.resource.data.updatedAt) &&
        request.resource.data.updatedBy == request.auth.uid;
    }
  }
}
