rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // There is no Firebase Authentication in this app at all, so there is
    // no `request.auth` to authorize anything against. Every read and
    // write goes exclusively through Next.js API routes using the Admin
    // SDK (which bypasses these rules entirely) — see the README's
    // "Data access model" section. This denies all direct client access
    // to every collection as defense in depth, even though nothing in the
    // app ever attempts it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
